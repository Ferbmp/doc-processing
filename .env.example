# Copy to .env to override any of the defaults baked into docker-compose.yml.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- Postgres ---
POSTGRES_DB=tally
POSTGRES_USER=tally
POSTGRES_PASSWORD=tally
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Processing pipeline ---
# Total attempts per document before it is parked in FAILED.
PROCESSING_MAX_ATTEMPTS=3
# Exponential backoff: base * 2**(attempt-1), capped, plus jitter.
PROCESSING_RETRY_BASE_SECONDS=2
PROCESSING_RETRY_MAX_SECONDS=60
PROCESSING_RETRY_JITTER_SECONDS=1
# A RUNNING job whose lock is older than this is assumed to belong to a dead
# worker and is recovered.
PROCESSING_STALE_JOB_TIMEOUT_SECONDS=60
PROCESSING_WORKER_POLL_INTERVAL_SECONDS=1
# Extractions below this confidence always go to human review.
PROCESSING_REVIEW_CONFIDENCE_THRESHOLD=0.85

# --- Simulated AI extraction service ---
# Relative weights used when a document does not force a specific outcome.
AI_SIM_WEIGHT_SUCCESS=55
AI_SIM_WEIGHT_LOW_CONFIDENCE=12
AI_SIM_WEIGHT_INCOMPLETE=10
AI_SIM_WEIGHT_ARITHMETIC_MISMATCH=5
AI_SIM_WEIGHT_TRANSIENT_FAILURE=13
AI_SIM_WEIGHT_PERMANENT_FAILURE=5
# Simulated call latency, milliseconds.
AI_SIM_LATENCY_MS=250
